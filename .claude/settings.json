{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Skill(*)",
      "WebFetch",
      "WebSearch",
      "Read(//Volumes/DATA/GitHub/**)",
      "Write(//Volumes/DATA/GitHub/**)",
      "Edit(//Volumes/DATA/GitHub/**)",
      "Read(//Users/lbruton/.claude/**)",
      "Write(//Users/lbruton/.claude/**)",
      "Edit(//Users/lbruton/.claude/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docvault-lint.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/vale-staged.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-safety.py"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-pr-merge.py"
          }
        ]
      }
    ]
  }
}
